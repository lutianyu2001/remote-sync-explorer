<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>remote-sync-explorer: third-party licenses (Rust)</title></head>
<!-- Copied to the repository's root as about.hbs; Per project: PROJECT, the project's name. -->
<body>
<h1>Third-party licenses: Rust dependencies</h1>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<p>Used by:</p>
<ul>
{{#each used_by}}
  <li>{{crate.name}} {{crate.version}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
